# Copy to .env and fill in. .env is gitignored; this file is not.

# Signs sessions, tokens and cookies. Required in production by any app that
# uses them: it refuses to start without it. Generate one with:  openssl rand -hex 32
APP_SECRET=

# SQLite database used locally. Cloudflare Workers deployment (via the
# platform plugin) provisions D1 automatically instead.
DATABASE_URL=sqlite://./data/dev.db

# Port the server listens on. Falls back to PORT when unset, so hosts that
# allocate a port themselves work without configuration.
# SERVER_PORT=3000

# Log verbosity: trace | debug | info | warn | error
# Also accepts per-module rules, e.g. LOG_LEVEL=alepha.core:warn,info
# LOG_LEVEL=info

# Log rendering: cli | pretty | json
# LOG_FORMAT=cli

# HTTP Basic Auth credentials gating the /admin dashboard and its API
# (collect-now, product catalogue management, run history). Defaults to
# admin/admin when unset — fine for a quick local check, but set both
# before leaving the app reachable from outside localhost.
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=admin

# Amazon/Cdiscount auto-discovery: which listing page(s) to scrape and how
# many of the resulting candidates to turn into deals per run. Defaults
# cover the general deal pages plus every category (Amazon's
# `deals?bubble-id=deals-collection-<category>` collections, Cdiscount's
# category hubs) — see CollectionService for the full lists. Setting a
# value here replaces the whole default list. Cards are taken round-robin
# across pages, de-duplicated, then capped at *_LIMIT.
# AMAZON_DEALS_URL=https://www.amazon.fr/deals,https://www.amazon.fr/deals?bubble-id=deals-collection-toys
# AMAZON_DEALS_LIMIT=60
# CDISCOUNT_HOME_URL=https://www.cdiscount.com/,https://www.cdiscount.com/maison/v-117-0.html
# CDISCOUNT_DEALS_LIMIT=90

# IsThereAnyDeal API key (free: register an app at
# https://isthereanydeal.com/apps/my/). Enables, for Steam deals, the
# all-time low across stores, the cheapest other store right now, and the
# price-history chart on the deal page. Leave unset to skip.
# ITAD_API_KEY=

# Automatic Dealabs publishing at the end of each collection run: deals
# from that run scoring AUTO_PUBLISH_MIN_SCORE or more are posted
# with your saved Dealabs session (« Se connecter à Dealabs »), best scores
# first, at most AUTO_PUBLISH_MAX_PER_RUN per run, one automatic attempt
# per deal. Local server only (it opens a visible browser window).
# AUTO_PUBLISH=true
# AUTO_PUBLISH_MIN_SCORE=65
# AUTO_PUBLISH_MAX_PER_RUN=3

# AliExpress deals page(s) and how many deals to take per run (product
# pages are only opened for new deals, then every 24 h).
# ALIEXPRESS_DEALS_URL=https://fr.aliexpress.com/ssr/300002660/Deals-HomePage?disableNav=YES&pha_manifest=ssr&_immersiveMode=true&businessCode=guide&source=superdeals
# ALIEXPRESS_DEALS_LIMIT=30
