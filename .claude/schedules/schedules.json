  "localTasks": [
    {
      "name": "DealRadar - soirée",
      "scheduler": "Windows Task Scheduler",
      "local_time": "17:00 every day (Paris)",
      "script": "scripts/agents/evening.ps1",
      "log": "data/agents/evening-<date>.log",
      "steps": [
        {
          "when": "Sunday",
          "skill": "deals-weekly",
          "agent": "results-reviewer",
          "model": "sonnet",
          "what": "weekly review of publish-rules.json"
        },
        {
          "when": "Sunday, if a proposal exists",
          "skill": "deals-code",
          "agent": "dev-agent + code-reviewer",
          "model": "sonnet",
          "what": "implements data/agents/code-proposal-*.md on a branch"
        },
        {
          "when": "Mon–Fri",
          "skill": "deals-select",
          "agent": "deal-selector",
          "model": "sonnet",
          "what": "picks tonight’s deals, then random-time publishing 17:30–21:30 (Node, no tokens)"
        },
        {
          "when": "Mon–Fri, after the draw",
          "skill": "deals-log plan",
          "model": "haiku",
          "what": "Notion plan log"
        },
        {
          "when": "every day (during publishing on weekdays)",
          "skill": "deals-sources",
          "agent": "sources-scout",
          "model": "sonnet",
          "what": "sources review → config/collection.json, probes, source proposals"
        },
        {
          "when": "every day",
          "skill": "deals-log final",
          "model": "haiku",
          "what": "Notion results and temperatures"
        },
        {
          "when": "every day, last",
          "skill": "deals-debrief",
          "model": "sonnet",
          "what": "Dealabs profile and comments → lessons, desirability, small rule steps"
        }
      ],
